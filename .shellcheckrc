# ShellCheck configuration for this repository.
#
# No `shell=` line, deliberately. Every script here declares bash in its shebang, and a
# `shell=dash` override made ShellCheck check them all as POSIX dash: over a hundred false
# errors (arrays, [[ ]], PIPESTATUS) that buried every real finding (#121). Let the shebang
# decide.
exclude=SC1090,SC1091,SC2034
