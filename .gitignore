.windsurfrules
.clinerules
.roo/
.roomodes
.devin/
.specstory/
.github/copilot-instructions.md
# --- leak-guard baseline: do not edit between the markers ---
# Assistant state directories, matched at any depth.
.antigravity/
.codeium/
.cline/
.sourcegraph/
.cody/
.tabnine/
.amazonq/
.junie/
