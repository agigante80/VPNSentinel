# VPN Sentinel Server Configuration
VPN_SENTINEL_API_KEY=your-secure-api-key-here
# Or read it from a file (Docker/Compose secret). Remove the line above first: setting both is a fatal error.
# VPN_SENTINEL_API_KEY_FILE=/run/secrets/vpn_sentinel_api_key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# Or read them from files (Docker/Compose secrets). Remove the lines above first: setting both is a fatal error.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id
# Optional: require "Authorization: Bearer <token>" on /metrics (generate with: openssl rand -hex 32).
# VPN_SENTINEL_METRICS_TOKEN=
# VPN_SENTINEL_METRICS_TOKEN_FILE=/run/secrets/vpn_sentinel_metrics_token
VPN_SENTINEL_API_PATH=/api/v1
VPN_SENTINEL_SERVER_ALLOWED_IPS=192.168.1.100,10.0.0.50
VPN_SENTINEL_SERVER_RATE_LIMIT_REQUESTS=30
VPN_SENTINEL_SERVER_ALERT_THRESHOLD_MINUTES=15
VPN_SENTINEL_SERVER_CHECK_INTERVAL_MINUTES=5
VPN_SENTINEL_SERVER_API_PORT=5000
VPN_SENTINEL_SERVER_DASHBOARD_PORT=8080
VPN_SENTINEL_SERVER_WEB_DASHBOARD_ENABLED=true
# Uncomment BOTH to serve HTTPS (the server exits with code 2 if only one is set or a file is missing).
# Mount the certs into the container, e.g. ./certs:/certs:ro
# VPN_SENTINEL_TLS_CERT_PATH=/certs/vpn-sentinel-cert.pem
# VPN_SENTINEL_TLS_KEY_PATH=/certs/vpn-sentinel-key.pem
TZ=UTC