# =============================================================================
# VPN SENTINEL MAIN ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your settings
# cp .env.example .env

# =============================================================================
# VPN CLIENT CONFIGURATION (Gluetun)
# =============================================================================

# VPN service provider (Gluetun-specific)
VPN_SERVICE_PROVIDER=privatevpn

# VPN account credentials
VPN_USER=your_vpn_username_here
VPN_PASSWORD=your_vpn_password_here

# Preferred server countries (comma-separated)
SERVER_COUNTRIES=Switzerland,Netherlands

# VPN update check interval
UPDATER_PERIOD=24h

# =============================================================================
# VPN SENTINEL COMMON CONFIGURATION
# =============================================================================

# API security key (generate with: openssl rand -hex 32)
VPN_SENTINEL_API_KEY=your_secure_random_api_key_here
# Or read it from a file (Docker/Compose secret). Remove the line above first: setting both is a fatal error.
# VPN_SENTINEL_API_KEY_FILE=/run/secrets/vpn_sentinel_api_key

# API path prefix
VPN_SENTINEL_API_PATH=/api/v1

# TLS certificate and key paths (for HTTPS)
# Uncomment BOTH to serve HTTPS (the server exits with code 2 if only one is set or a file is missing).
# Mount the certs into the container, e.g. ./certs:/certs:ro
# VPN_SENTINEL_TLS_CERT_PATH=/certs/vpn-sentinel-cert.pem
# VPN_SENTINEL_TLS_KEY_PATH=/certs/vpn-sentinel-key.pem

# Timezone for timestamps
TZ=UTC

# =============================================================================
# VPN SENTINEL CLIENT CONFIGURATION
# =============================================================================

# Monitoring server address inside the compose stack. The client URL is built from
# VPN_SENTINEL_SERVER_IP in compose.yaml (gluetun's DNS cannot resolve service names), so
# there is no VPN_SENTINEL_URL here. Uncomment both only if 198.18.0.0/24 clashes with a
# network you already use; they move the server address and the firewall allowance together.
# VPN_SENTINEL_SERVER_IP=198.18.0.10
# VPN_SENTINEL_DOCKER_SUBNET=198.18.0.0/24

# Unique client identifier
VPN_SENTINEL_CLIENT_ID=vpn-monitor-main

# Debug logging (true/false)
VPN_SENTINEL_DEBUG=false

# Geolocation service (auto/ipinfo.io/ip-api.com/ipwhois.app)
# auto: try providers in order (ipinfo.io -> ip-api.com -> ipwhois.app)
# <provider>: force a single provider (no fallbacks) — useful for deterministic behavior
VPN_SENTINEL_GEOLOCATION_SERVICE=auto

# Enable dedicated health monitoring process (true/false)
VPN_SENTINEL_HEALTH_MONITOR=false

# Port for dedicated health monitor (default: 8082)
VPN_SENTINEL_HEALTH_PORT=8082

# Optional: Path to pidfile used by the health monitor wrapper. Tests and the
# smoke script may set this to a predictable location (for example:
# /tmp/vpn-sentinel-health-monitor.pid). If unset a sensible default is used.
VPN_SENTINEL_HEALTH_PIDFILE=/tmp/vpn-sentinel-health-monitor.pid

# =============================================================================
# VPN SENTINEL SERVER CONFIGURATION
# =============================================================================

# API server port
VPN_SENTINEL_SERVER_API_PORT=5000

# Web dashboard port
VPN_SENTINEL_SERVER_DASHBOARD_PORT=8080

# Rate limiting (requests per minute per IP)
VPN_SENTINEL_SERVER_RATE_LIMIT_REQUESTS=30

# IP whitelist (comma-separated, empty = allow all)
VPN_SENTINEL_SERVER_ALLOWED_IPS=

# Alert threshold (minutes before offline alert)
VPN_SENTINEL_SERVER_ALERT_THRESHOLD_MINUTES=15

# Client check interval (minutes)
VPN_SENTINEL_SERVER_CHECK_INTERVAL_MINUTES=5

# Telegram notifications (optional but recommended)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Or read them from files (Docker/Compose secrets). Remove the lines above first: setting both is a fatal error.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
# TELEGRAM_CHAT_ID_FILE=/run/secrets/telegram_chat_id

# Optional: require "Authorization: Bearer <token>" on /metrics (generate with: openssl rand -hex 32).
# VPN_SENTINEL_METRICS_TOKEN=
# VPN_SENTINEL_METRICS_TOKEN_FILE=/run/secrets/vpn_sentinel_metrics_token

# Web dashboard enable/disable
VPN_SENTINEL_SERVER_WEB_DASHBOARD_ENABLED=true

